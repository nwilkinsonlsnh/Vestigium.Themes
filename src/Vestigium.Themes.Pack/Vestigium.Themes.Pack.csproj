<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pack-only bag. Restore name is Vestigium.Themes.Pack (this file).
    PackageId becomes Vestigium.Themes only when writing the nuspec so restore
    does not collide with src/Vestigium.Themes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Vestigium.Themes.Pack</AssemblyName>
    <RootNamespace>Vestigium.Themes.Pack</RootNamespace>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <Version>1.0.0</Version>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <Copyright>Copyright (c) 2026 Nathaniel Wilkinson / LSNH</Copyright>
    <Description>Modular WPF theming for the Vestigium suite — ThemeManager, control catalog, and all v1 palettes in one package.</Description>
    <PackageTags>wpf;themes;vestigium;mvvm;net10</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nwilkinsonlsnh/Vestigium.Themes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nwilkinsonlsnh/Vestigium.Themes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Themes\Vestigium.Themes.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.Controls\Vestigium.Themes.Controls.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.LightBlue\Vestigium.Themes.LightBlue.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.DarkMode\Vestigium.Themes.DarkMode.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.Terminal\Vestigium.Themes.Terminal.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.SolarizedDark\Vestigium.Themes.SolarizedDark.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.StandardWPF\Vestigium.Themes.StandardWPF.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.Monokai\Vestigium.Themes.Monokai.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.Sublime\Vestigium.Themes.Sublime.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Vestigium.Themes.Dracula\Vestigium.Themes.Dracula.csproj" PrivateAssets="all" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <Target Name="_SetPublishedPackageId" BeforeTargets="GenerateNuspec;Pack">
    <PropertyGroup>
      <PackageId>Vestigium.Themes</PackageId>
    </PropertyGroup>
  </Target>

  <Target Name="_PackProductAssemblies" BeforeTargets="_GetPackageFiles;GenerateNuspec" DependsOnTargets="ResolveReferences;Build">
    <ItemGroup>
      <_ProductAssembly Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
      <TfmSpecificPackageFile Include="@(_ProductAssembly)">
        <PackagePath>lib/$(TargetFramework)/%(FileName)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
