<UserControl x:Class="Vestigium.Themes.Demo.Views.DnsIqTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource TextBlock.Subheader}" Text="DnsIQ" />
            <TextBlock Style="{StaticResource TextBlock.Caption}"
                       Text="vestigium.local · IN · DataGrid.Compact — type chips use Status.InfoFill so they follow the palette." />
        </StackPanel>

        <Border Style="{StaticResource Border.Panel}" DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource TextBox.Standard}"
                         Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="2"
                          Style="{StaticResource ComboBox.Standard}"
                          SelectedValue="{Binding RecordType}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Style="{StaticResource ComboBoxItem.Standard}" Content="A" />
                    <ComboBoxItem Style="{StaticResource ComboBoxItem.Standard}" Content="AAAA" />
                    <ComboBoxItem Style="{StaticResource ComboBoxItem.Standard}" Content="MX" />
                    <ComboBoxItem Style="{StaticResource ComboBoxItem.Standard}" Content="TXT" />
                    <ComboBoxItem Style="{StaticResource ComboBoxItem.Standard}" Content="ANY" />
                </ComboBox>
                <Button Grid.Column="4" Style="{StaticResource Button.Primary}" Content="Query" Width="96"
                        Command="{Binding PingCommand}" />
            </Grid>
        </Border>

        <DataGrid Style="{StaticResource DataGrid.Compact}"
                  ItemsSource="{Binding DnsRecords}"
                  SelectedItem="{Binding SelectedDns}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Type" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Vestigium.Brushes.Status.InfoFill}"
                                    CornerRadius="4" Padding="6,1" Margin="4,2"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Type}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Vestigium.Brushes.Status.Info}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*" />
                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="2*" />
                <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
