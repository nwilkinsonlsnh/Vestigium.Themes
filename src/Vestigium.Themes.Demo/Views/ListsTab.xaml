<UserControl x:Class="Vestigium.Themes.Demo.Views.ListsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource Grid.Standard}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}"
                       Text="ListBox.Standard" Margin="0,0,0,8" />
            <ListBox Style="{StaticResource ListBox.Standard}"
                     ItemsSource="{Binding RecentQueries}" />
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}"
                       Text="ListBox.Card" Margin="0,0,0,8" />
            <ListBox Style="{StaticResource ListBox.Card}"
                     ItemContainerStyle="{StaticResource ListBoxItem.Card}"
                     ItemsSource="{Binding Interfaces}" />
        </DockPanel>

        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}"
                       Text="ListView.Standard + GridView  (same PingTargets as the DataGrid)"
                       Margin="0,0,0,8" />
            <ListView Style="{StaticResource ListView.Standard}"
                      ItemsSource="{Binding PingTargets}"
                      SelectedItem="{Binding SelectedPing}">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeader.Standard}">
                        <GridViewColumn Header="Host" DisplayMemberBinding="{Binding Host}" Width="160" />
                        <GridViewColumn Header="IP" DisplayMemberBinding="{Binding Ip}" Width="120" />
                        <GridViewColumn Header="Avg" DisplayMemberBinding="{Binding Avg}" Width="70" />
                        <GridViewColumn Header="Loss" DisplayMemberBinding="{Binding Loss}" Width="70" />
                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</UserControl>
