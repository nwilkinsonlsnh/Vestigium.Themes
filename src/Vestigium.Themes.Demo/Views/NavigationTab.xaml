<UserControl x:Class="Vestigium.Themes.Demo.Views.NavigationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource Grid.Standard}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Border.AppSidebar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource TextBlock.Caption}"
                           Text="TreeView.Flush · accordion"
                           Margin="8,8,8,4" />
                <TreeView Style="{StaticResource TreeView.Flush}">
                    <TreeViewItem Header="Instruments" Style="{StaticResource TreeViewItem.AccordionParent}" IsExpanded="True">
                        <TreeViewItem Header="Hamilton" Style="{StaticResource TreeViewItem.AccordionGroup}" IsExpanded="True">
                            <TreeViewItem Header="Microlab Prep" Style="{StaticResource TreeViewItem.AccordionChild}" />
                            <TreeViewItem Header="STAR" Style="{StaticResource TreeViewItem.AccordionChild}" />
                        </TreeViewItem>
                        <TreeViewItem Header="Sciex" Style="{StaticResource TreeViewItem.AccordionGroup}">
                            <TreeViewItem Header="6500+" Style="{StaticResource TreeViewItem.AccordionChild}" />
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="Network" Style="{StaticResource TreeViewItem.AccordionParent}" IsExpanded="True">
                        <TreeViewItem Header="PingIQ" Style="{StaticResource TreeViewItem.AccordionChild}" />
                        <TreeViewItem Header="DnsIQ" Style="{StaticResource TreeViewItem.AccordionChild}" />
                        <TreeViewItem Header="TraceIQ" Style="{StaticResource TreeViewItem.AccordionChild}" />
                    </TreeViewItem>
                </TreeView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource GridSplitter.Bar}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="8" />

        <ScrollViewer Grid.Column="2" Style="{StaticResource ScrollViewer.Standard}" Padding="12,0,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.Caption}"
                           Text="TabControl.Standard · nested General / Advanced / Logging"
                           Margin="0,0,0,8" />
                <TabControl Style="{StaticResource TabControl.Standard}" Height="150">
                    <TabItem Style="{StaticResource TabItem.Standard}" Header="General">
                        <TextBlock Style="{StaticResource TextBlock.Standard}" Margin="12"
                                   Text="Timeout 1000 ms · TTL 128 · payload 32 bytes." />
                    </TabItem>
                    <TabItem Style="{StaticResource TabItem.Standard}" Header="Advanced">
                        <TextBlock Style="{StaticResource TextBlock.Standard}" Margin="12"
                                   Text="Do not fragment · record route · timestamp." />
                    </TabItem>
                    <TabItem Style="{StaticResource TabItem.Standard}" Header="Logging">
                        <TextBlock Style="{StaticResource TextBlock.Standard}" Margin="12"
                                   Text="Write pcap to %LOCALAPPDATA%\Vestigium\traces." />
                    </TabItem>
                </TabControl>

                <TextBlock Style="{StaticResource TextBlock.Caption}"
                           Text="TabControl.Pill" Margin="0,16,0,8" />
                <TabControl Style="{StaticResource TabControl.Pill}" Height="110">
                    <TabItem Style="{StaticResource TabItem.Pill}" Header="Live">
                        <TextBlock Style="{StaticResource TextBlock.Standard}" Margin="12" Text="Continuous ICMP echo." />
                    </TabItem>
                    <TabItem Style="{StaticResource TabItem.Pill}" Header="Burst">
                        <TextBlock Style="{StaticResource TextBlock.Standard}" Margin="12" Text="32 packets then stop." />
                    </TabItem>
                    <TabItem Style="{StaticResource TabItem.Pill}" Header="Sweep">
                        <TextBlock Style="{StaticResource TextBlock.Standard}" Margin="12" Text="TTL increment 1..30." />
                    </TabItem>
                </TabControl>

                <TextBlock Style="{StaticResource TextBlock.Caption}"
                           Text="TabControl.Vertical + RadioButton.Pill / HorizontalTab"
                           Margin="0,16,0,8" />
                <Grid Height="160">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TabControl Style="{StaticResource TabControl.Vertical}" TabStripPlacement="Left">
                        <TabItem Style="{StaticResource TabItem.Vertical}" Header="IPv4">
                            <TextBlock Style="{StaticResource TextBlock.Standard}" Margin="12" Text="A records, ICMP echo." />
                        </TabItem>
                        <TabItem Style="{StaticResource TabItem.Vertical}" Header="IPv6">
                            <TextBlock Style="{StaticResource TextBlock.Standard}" Margin="12" Text="AAAA, ICMPv6." />
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Style="{StaticResource RadioButton.Pill}" Content="General" IsChecked="True" Margin="0,0,8,0" />
                            <RadioButton Style="{StaticResource RadioButton.Pill}" Content="Advanced" Margin="0,0,8,0" />
                            <RadioButton Style="{StaticResource RadioButton.Pill}" Content="Logging" />
                        </StackPanel>
                        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Summary" IsChecked="True" />
                        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Raw packets" />
                        <RadioButton Style="{StaticResource RadioButton.VerticalNav}" Content="All interfaces" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>

                <Expander Style="{StaticResource Expander.Card}" Header="Expander.Card · ListBox.Flush" IsExpanded="True" Margin="0,16,0,0">
                    <ListBox Style="{StaticResource ListBox.Flush}" Height="120"
                             ItemsSource="{Binding RecentQueries}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
