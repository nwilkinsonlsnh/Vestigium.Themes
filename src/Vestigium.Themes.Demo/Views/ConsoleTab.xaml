<UserControl x:Class="Vestigium.Themes.Demo.Views.ConsoleTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource Grid.Standard}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="0.7*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}"
                       Text="Bound log · Vestigium.Brushes.Terminal.* (info / success / warn / error)"
                       Margin="0,0,0,8" />
            <Border Background="{DynamicResource Vestigium.Brushes.Terminal.Background}"
                    BorderBrush="{DynamicResource Vestigium.Brushes.Terminal.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer Style="{StaticResource ScrollViewer.Standard}">
                    <ItemsControl ItemsSource="{Binding ConsoleLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource Vestigium.Fonts.Family.Mono}"
                                           FontSize="12.5" Margin="0,1"
                                           Text="{Binding Line}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Terminal.Foreground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="error">
                                                    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Terminal.Error}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="success">
                                                    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Terminal.String}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Status.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}"
                       Text="RichTextBox.ConsoleLog"
                       Margin="0,0,0,8" />
            <RichTextBox Style="{StaticResource RichTextBox.ConsoleLog}" IsReadOnly="True">
                <FlowDocument FontFamily="{StaticResource Vestigium.Fonts.Family.Mono}" FontSize="13">
                    <Paragraph>
                        <Run Text="14:02:11.041  ICMP echo  8.8.8.8     time=12.4 ms" />
                    </Paragraph>
                    <Paragraph>
                        <Run Text="14:02:12.044  ICMP echo  8.8.8.8     time=11.8 ms" />
                    </Paragraph>
                    <Paragraph>
                        <Run Text="14:02:13.040  ICMP echo  10.0.0.1    Destination host unreachable" />
                    </Paragraph>
                    <Paragraph>
                        <Run Text="14:02:15.048  ICMP echo  1.1.1.1     time=8.2 ms" />
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}"
                       Text="RichTextBox.CodeViewer — host integration snippet"
                       Margin="0,0,0,8" />
            <RichTextBox Style="{StaticResource RichTextBox.CodeViewer}" IsReadOnly="True">
                <FlowDocument FontFamily="{StaticResource Vestigium.Fonts.Family.Mono}" FontSize="13">
                    <Paragraph>
                        <Run Text="var manager = new ThemeManager();" />
                    </Paragraph>
                    <Paragraph>
                        <Run Text="manager.Register(ThemeDefinition.FromPack(" />
                    </Paragraph>
                    <Paragraph>
                        <Run Text='    "LightBlue", "Light Blue", "Vestigium.Themes.LightBlue", isDark: false));' />
                    </Paragraph>
                    <Paragraph>
                        <Run Text='manager.Initialize(Application.Current, "LightBlue");' />
                    </Paragraph>
                    <Paragraph>
                        <Run Text='manager.SwitchTheme("Dracula");' />
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </DockPanel>
    </Grid>
</UserControl>
