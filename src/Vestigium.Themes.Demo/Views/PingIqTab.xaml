<UserControl x:Class="Vestigium.Themes.Demo.Views.PingIqTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource Button.Primary}" Content="Ping" Width="88"
                        Command="{Binding PingCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Danger}" Content="Stop" Width="88"
                        Command="{Binding StopCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Secondary}" Content="Export" Width="88"
                        Command="{Binding ExportCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.Subheader}" Text="PingIQ" />
                <TextBlock Style="{StaticResource TextBlock.Caption}"
                           Text="ICMP reachability · DataGrid.Standard — switch palettes and watch hover, selection, and status hues recompute." />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Border.Card}" DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBlock.Caption}" Text="Selected host" />
                    <TextBlock Style="{StaticResource TextBlock.Standard}" FontWeight="SemiBold"
                               Text="{Binding SelectedPing.Host}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource TextBlock.Caption}" Text="Address" />
                    <TextBlock Style="{StaticResource TextBlock.Standard}"
                               FontFamily="{StaticResource Vestigium.Fonts.Family.Mono}"
                               Text="{Binding SelectedPing.Ip}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource TextBlock.Caption}" Text="Average / loss" />
                    <TextBlock Style="{StaticResource TextBlock.Standard}">
                        <Run Text="{Binding SelectedPing.Avg, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding SelectedPing.Loss, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource TextBlock.Caption}" Text="Status" />
                    <TextBlock Style="{StaticResource TextBlock.Standard}" Text="{Binding SelectedPing.Status}" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Style="{StaticResource DataGrid.Standard}"
                  ItemsSource="{Binding PingTargets}"
                  SelectedItem="{Binding SelectedPing}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow">
            <DataGrid.ContextMenu>
                <ContextMenu Style="{StaticResource ContextMenu.Standard}">
                    <MenuItem Header="Copy host" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding CopyHostCommand}" />
                    <MenuItem Header="Ping again" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding PingCommand}" />
                    <Separator Style="{StaticResource Separator.Menu}" />
                    <MenuItem Header="Export selection" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ExportCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="1.6*" />
                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="1.2*" />
                <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="80" />
                <DataGridTextColumn Header="Avg" Binding="{Binding Avg}" Width="80" />
                <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="80" />
                <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="72" />
                <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="64" />
                <DataGridTemplateColumn Header="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource Ellipse.Standard}">
                                            <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Status.Neutral}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Reachable">
                                                    <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Status.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Degraded">
                                                    <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Status.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Timeout">
                                                    <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Status.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource TextBlock.Standard}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
