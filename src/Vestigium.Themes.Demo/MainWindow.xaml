<Window x:Class="Vestigium.Themes.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vestigium.Themes.Demo.Views"
        Title="Vestigium Themes Demo"
        Width="1280" Height="860"
        MinWidth="960" MinHeight="640"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
        TextElement.Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
        FontFamily="{StaticResource Vestigium.Fonts.Family.UI}"
        FontSize="14">
    <DockPanel Style="{StaticResource DockPanel.Standard}">

        <Menu Style="{StaticResource Menu.Standard}" DockPanel.Dock="Top">
            <MenuItem Header="_File" Style="{StaticResource MenuItem.Standard}">
                <MenuItem Header="_Ping" Style="{StaticResource MenuItem.Standard}"
                          InputGestureText="Ctrl+P"
                          Command="{Binding PingCommand}" />
                <MenuItem Header="_Stop" Style="{StaticResource MenuItem.Standard}"
                          Command="{Binding StopCommand}" />
                <Separator Style="{StaticResource Separator.Menu}" />
                <MenuItem Header="_Export…" Style="{StaticResource MenuItem.Standard}"
                          Command="{Binding ExportCommand}" />
                <Separator Style="{StaticResource Separator.Menu}" />
                <MenuItem Header="E_xit" Style="{StaticResource MenuItem.Standard}"
                          Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_View" Style="{StaticResource MenuItem.Standard}">
                <MenuItem Header="_Theme" Style="{StaticResource MenuItem.Standard}">
                    <MenuItem Header="Light Blue" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ApplyThemeCommand}" CommandParameter="LightBlue" />
                    <MenuItem Header="Dark Mode" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ApplyThemeCommand}" CommandParameter="DarkMode" />
                    <MenuItem Header="Terminal" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ApplyThemeCommand}" CommandParameter="Terminal" />
                    <MenuItem Header="Solarized Dark" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ApplyThemeCommand}" CommandParameter="SolarizedDark" />
                    <MenuItem Header="Standard WPF" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ApplyThemeCommand}" CommandParameter="StandardWPF" />
                    <MenuItem Header="Monokai" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ApplyThemeCommand}" CommandParameter="Monokai" />
                    <MenuItem Header="Sublime" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ApplyThemeCommand}" CommandParameter="Sublime" />
                    <MenuItem Header="Dracula" Style="{StaticResource MenuItem.Standard}"
                              Command="{Binding ApplyThemeCommand}" CommandParameter="Dracula" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource MenuItem.Standard}">
                <MenuItem Header="_Developers Guide" Style="{StaticResource MenuItem.Standard}"
                          InputGestureText="_Documentation" />
            </MenuItem>
        </Menu>

        <ToolBarTray Style="{StaticResource ToolBarTray.Standard}" DockPanel.Dock="Top">
            <ToolBar Style="{StaticResource ToolBar.Standard}">
                <Button Style="{StaticResource Button.Primary}" Content="Ping"
                        Command="{Binding PingCommand}" Padding="12,4" />
                <Button Style="{StaticResource Button.Danger}" Content="Stop"
                        Command="{Binding StopCommand}" Padding="12,4" Margin="6,0,0,0" />
                <Button Style="{StaticResource Button.Secondary}" Content="Export"
                        Command="{Binding ExportCommand}" Padding="12,4" Margin="6,0,0,0" />
                <Separator Style="{StaticResource Separator.Vertical}" Margin="10,4" />
                <TextBlock Style="{StaticResource TextBlock.Caption}"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedPing.Host, StringFormat=Target: {0}}" />
            </ToolBar>
        </ToolBarTray>

        <Border Style="{StaticResource Border.AppHeader}" DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource TextBlock.Heading}" Text="Vestigium Themes" />
                    <TextBlock Style="{StaticResource TextBlock.Caption}"
                               Text="Runtime palette swap · explicit styles · TabControl gallery" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource ComboBox.Standard}"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="Switch palette — Button.Primary and friends stay the same keys" />
            </Grid>
        </Border>

        <StatusBar Style="{StaticResource StatusBar.Standard}" DockPanel.Dock="Bottom">
            <StatusBarItem Style="{StaticResource StatusBarItem.Standard}">
                <TextBlock Text="{Binding SelectedTheme.DisplayName, StringFormat=Theme: {0}}" />
            </StatusBarItem>
            <Separator Style="{StaticResource Separator.StatusBar}" />
            <StatusBarItem Style="{StaticResource StatusBarItem.Standard}">
                <TextBlock Text="{Binding SelectedPing.Host, StringFormat=Selected: {0}}" />
            </StatusBarItem>
            <Separator Style="{StaticResource Separator.StatusBar}" />
            <StatusBarItem Style="{StaticResource StatusBarItem.Standard}">
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator Style="{StaticResource Separator.StatusBar}" />
            <StatusBarItem Style="{StaticResource StatusBarItem.Standard}" HorizontalAlignment="Right">
                <TextBlock Text="Contract 1.0  ·  net10.0-windows" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Style="{StaticResource TabControl.Standard}" Margin="12">
            <TabItem Style="{StaticResource TabItem.Standard}" Header="Buttons">
                <views:ButtonsTab />
            </TabItem>
            <TabItem Style="{StaticResource TabItem.Standard}" Header="Data entry">
                <views:DataEntryTab />
            </TabItem>
            <TabItem Style="{StaticResource TabItem.Standard}" Header="Lists">
                <views:ListsTab />
            </TabItem>
            <TabItem Style="{StaticResource TabItem.Standard}" Header="PingIQ">
                <views:PingIqTab />
            </TabItem>
            <TabItem Style="{StaticResource TabItem.Standard}" Header="DnsIQ">
                <views:DnsIqTab />
            </TabItem>
            <TabItem Style="{StaticResource TabItem.Standard}" Header="TraceIQ">
                <views:TraceIqTab />
            </TabItem>
            <TabItem Style="{StaticResource TabItem.Standard}" Header="Navigation">
                <views:NavigationTab />
            </TabItem>
            <TabItem Style="{StaticResource TabItem.Standard}" Header="Layout">
                <views:LayoutTab />
            </TabItem>
            <TabItem Style="{StaticResource TabItem.Standard}" Header="Console">
                <views:ConsoleTab />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
