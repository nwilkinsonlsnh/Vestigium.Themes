<Window x:Class="Vestigium.Themes.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vestigium Themes Demo"
        Width="1100" Height="720"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
        TextElement.Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
        FontFamily="{StaticResource Vestigium.Fonts.Family.UI}"
        FontSize="14">
    <DockPanel Style="{StaticResource DockPanel.Standard}">
        <Border Style="{StaticResource Border.AppHeader}" DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource TextBlock.Heading}" Text="Vestigium Themes" />
                    <TextBlock Style="{StaticResource TextBlock.Caption}" Text="Runtime palette swap — control catalog" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource ComboBox.Standard}"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="DisplayName" />
            </Grid>
        </Border>

        <StatusBar Style="{StaticResource StatusBar.Standard}" DockPanel.Dock="Bottom">
            <StatusBarItem Style="{StaticResource StatusBarItem.Standard}">
                <TextBlock Text="{Binding SelectedTheme.DisplayName, StringFormat=Theme: {0}}" />
            </StatusBarItem>
            <Separator Style="{StaticResource Separator.StatusBar}" />
            <StatusBarItem Style="{StaticResource StatusBarItem.Standard}">
                <TextBlock Text="Contract 1.0  ·  net10.0-windows" />
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer Style="{StaticResource ScrollViewer.Standard}" Padding="16">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.Subheader}" Text="Buttons" Margin="0,0,0,8" />
                <WrapPanel Style="{StaticResource WrapPanel.Toolbar}">
                    <Button Style="{StaticResource Button.Primary}" Content="Primary" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Secondary" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Success}" Content="Success" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Warning}" Content="Warning" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Danger}" Content="Danger" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Utility}" Content="Utility" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Primary}" Content="Disabled" IsEnabled="False" Margin="0,0,8,8" />
                </WrapPanel>

                <TextBlock Style="{StaticResource TextBlock.Subheader}" Text="Data entry" Margin="0,16,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Label Style="{StaticResource Label.Standard}" Content="_Host" />
                        <TextBox Style="{StaticResource TextBox.Standard}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Style="{StaticResource Label.Standard}" Content="Password" Margin="0,8,0,0" />
                        <PasswordBox Style="{StaticResource PasswordBox.Standard}" />
                        <CheckBox Style="{StaticResource CheckBox.Standard}" Content="Resolve PTR" IsChecked="True" />
                        <CheckBox Style="{StaticResource CheckBox.ToggleSwitch}" Content="Continuous ping" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Style="{StaticResource Label.Standard}" Content="Record type" />
                        <ComboBox Style="{StaticResource ComboBox.Standard}" SelectedIndex="0">
                            <ComboBoxItem Content="A" />
                            <ComboBoxItem Content="AAAA" />
                            <ComboBoxItem Content="MX" />
                            <ComboBoxItem Content="TXT" />
                        </ComboBox>
                        <Label Style="{StaticResource Label.Standard}" Content="Validation" Margin="0,8,0,0" />
                        <TextBox Style="{StaticResource TextBox.Error}" Text="invalid host" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton Style="{StaticResource RadioButton.Standard}" Content="ICMP" IsChecked="True" Margin="0,0,12,0" />
                            <RadioButton Style="{StaticResource RadioButton.Standard}" Content="TCP" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource TextBlock.Subheader}" Text="Status" Margin="0,16,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource Ellipse.Success}" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource TextBlock.Standard}" Text="Reachable" Margin="0,0,16,0" />
                    <Ellipse Style="{StaticResource Ellipse.Warning}" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource TextBlock.Standard}" Text="Loss" Margin="0,0,16,0" />
                    <Ellipse Style="{StaticResource Ellipse.Error}" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource TextBlock.Error}" Text="Timeout" />
                </StackPanel>
                <ProgressBar Style="{StaticResource ProgressBar.Standard}" Value="65" Maximum="100" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
