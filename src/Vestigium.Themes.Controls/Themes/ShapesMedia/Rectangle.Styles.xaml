<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI RECTANGLE SHAPE STYLES
         =======================================================================
         Usage: 
         <Rectangle Style="{StaticResource Rectangle.Accent}" Height="4" />
         <Rectangle Style="{StaticResource Rectangle.Divider}" />

         Available Styles:
         - Rectangle.Standard : Neutral fill with thin border
         - Rectangle.Divider  : Thin 1px section divider line
         - Rectangle.Accent   : Theme blue solid bar / indicator
         - Rectangle.Rounded  : Rounded-corner rectangle (4px radius)
         ======================================================================= -->

    <!-- Base -->
    <Style x:Key="Rectangle.Base" TargetType="Rectangle">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Standard – outlined -->
    <Style x:Key="Rectangle.Standard" TargetType="Rectangle" BasedOn="{StaticResource Rectangle.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="Stroke" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- Divider – thin section line -->
    <Style x:Key="Rectangle.Divider" TargetType="Rectangle" BasedOn="{StaticResource Rectangle.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Accent – theme blue bar -->
    <Style x:Key="Rectangle.Accent" TargetType="Rectangle" BasedOn="{StaticResource Rectangle.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
    </Style>

    <!-- Rounded -->
    <Style x:Key="Rectangle.Rounded" TargetType="Rectangle" BasedOn="{StaticResource Rectangle.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="Stroke" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="RadiusX" Value="4" />
        <Setter Property="RadiusY" Value="4" />
    </Style>

</ResourceDictionary>