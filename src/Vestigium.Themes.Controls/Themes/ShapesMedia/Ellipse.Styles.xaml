<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI ELLIPSE SHAPE STYLES
         =======================================================================
         Usage: 
         <Ellipse Style="{StaticResource Ellipse.Accent}" Width="12" Height="12" />

         Available Styles:
         - Ellipse.Standard : White fill with thin neutral border
         - Ellipse.Accent   : Theme blue solid fill
         - Ellipse.Success  : Green status indicator
         - Ellipse.Warning  : Orange warning indicator
         - Ellipse.Error    : Red error / alert indicator
         ======================================================================= -->

    <!-- Base -->
    <Style x:Key="Ellipse.Base" TargetType="Ellipse">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <!-- Standard – outlined -->
    <Style x:Key="Ellipse.Standard" TargetType="Ellipse" BasedOn="{StaticResource Ellipse.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="Stroke" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- Accent – theme blue -->
    <Style x:Key="Ellipse.Accent" TargetType="Ellipse" BasedOn="{StaticResource Ellipse.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
    </Style>

    <!-- Success -->
    <Style x:Key="Ellipse.Success" TargetType="Ellipse" BasedOn="{StaticResource Ellipse.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Status.Success}" />
    </Style>

    <!-- Warning -->
    <Style x:Key="Ellipse.Warning" TargetType="Ellipse" BasedOn="{StaticResource Ellipse.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Status.Warning}" />
    </Style>

    <!-- Error -->
    <Style x:Key="Ellipse.Error" TargetType="Ellipse" BasedOn="{StaticResource Ellipse.Base}">
        <Setter Property="Fill" Value="{DynamicResource Vestigium.Brushes.Status.Error}" />
    </Style>

</ResourceDictionary>