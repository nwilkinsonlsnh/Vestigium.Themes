<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI SCROLLVIEWER STYLES
         =======================================================================
         Usage:
         <ScrollViewer Style="{StaticResource ScrollViewer.Standard}">
             <StackPanel>...</StackPanel>
         </ScrollViewer>

         Available Styles:
         - ScrollViewer.Standard        : Vertical scrolling (themed scrollbars)
         - ScrollViewer.Horizontal      : Horizontal scrolling
         - ScrollViewer.Both            : Bi-directional scrolling
         - ScrollViewer.Minimal         : Vertical scrolling with minimal scrollbars
         - ScrollViewer.Both.Minimal    : Bi-directional with minimal scrollbars

         Requires: ScrollBar.Styles.xaml (ScrollBar.Standard / ScrollBar.Minimal)

         Note: ScrollBar styles inside templates use DynamicResource so the keys
         resolve at runtime against the full application theme, not only at
         dictionary parse time. This avoids "Cannot find resource named
         ScrollBar.Standard" when library UserControls first load.
         ======================================================================= -->

    <!-- ========================================== -->
    <!-- 1. SHARED TEMPLATES                        -->
    <!-- ========================================== -->

    <!-- Standard template (uses ScrollBar.Standard via DynamicResource) -->
    <ControlTemplate x:Key="ScrollViewer.Template.Standard" TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Content -->
            <ScrollContentPresenter Grid.Column="0"
                                    Grid.Row="0"
                                    Margin="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

            <!-- Vertical scrollbar -->
            <ScrollBar x:Name="PART_VerticalScrollBar"
                       Grid.Column="1"
                       Grid.Row="0"
                       Style="{DynamicResource ScrollBar.Standard}"
                       Orientation="Vertical"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

            <!-- Horizontal scrollbar -->
            <ScrollBar x:Name="PART_HorizontalScrollBar"
                       Grid.Column="0"
                       Grid.Row="1"
                       Style="{DynamicResource ScrollBar.Standard}"
                       Orientation="Horizontal"
                       Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
        </Grid>
    </ControlTemplate>

    <!-- Minimal template (uses ScrollBar.Minimal via DynamicResource) -->
    <ControlTemplate x:Key="ScrollViewer.Template.Minimal" TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollContentPresenter Grid.Column="0"
                                    Grid.Row="0"
                                    Margin="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

            <ScrollBar x:Name="PART_VerticalScrollBar"
                       Grid.Column="1"
                       Grid.Row="0"
                       Style="{DynamicResource ScrollBar.Minimal}"
                       Orientation="Vertical"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

            <ScrollBar x:Name="PART_HorizontalScrollBar"
                       Grid.Column="0"
                       Grid.Row="1"
                       Style="{DynamicResource ScrollBar.Minimal}"
                       Orientation="Horizontal"
                       Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
        </Grid>
    </ControlTemplate>

    <!-- ========================================== -->
    <!-- 2. BASE                                    -->
    <!-- ========================================== -->
    <Style x:Key="ScrollViewer.Base" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource ScrollViewer.Template.Standard}" />
    </Style>

    <!-- ========================================== -->
    <!-- 3. STANDARD VARIANTS                       -->
    <!-- ========================================== -->

    <Style x:Key="ScrollViewer.Standard" TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer.Base}">
        <!-- Vertical Auto, Horizontal Disabled, Standard scrollbars -->
    </Style>

    <Style x:Key="ScrollViewer.Horizontal" TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer.Base}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="ScrollViewer.Both" TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer.Base}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ========================================== -->
    <!-- 4. MINIMAL VARIANTS                        -->
    <!-- ========================================== -->

    <Style x:Key="ScrollViewer.Minimal" TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer.Base}">
        <Setter Property="Template" Value="{StaticResource ScrollViewer.Template.Minimal}" />
    </Style>

    <Style x:Key="ScrollViewer.Both.Minimal" TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer.Base}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource ScrollViewer.Template.Minimal}" />
    </Style>

</ResourceDictionary>