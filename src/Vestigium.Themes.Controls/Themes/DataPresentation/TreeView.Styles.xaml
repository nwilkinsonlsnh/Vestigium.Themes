<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI TREEVIEW STYLES
         =======================================================================
         Usage (Classic hierarchical – unlimited depth):
         <TreeView Style="{StaticResource TreeView.Standard}">
             <TreeViewItem Header="Root" Style="{StaticResource TreeViewItem.Standard}">
                 <TreeViewItem Header="Child" Style="{StaticResource TreeViewItem.Standard}" />
             </TreeViewItem>
         </TreeView>

         Usage (3-level Accordion sidebar):
         <TreeView Style="{StaticResource TreeView.Flush}">
             <TreeViewItem Header="Settings" Style="{StaticResource TreeViewItem.AccordionParent}">
                 <TreeViewItem Header="General" Style="{StaticResource TreeViewItem.AccordionGroup}">
                     <TreeViewItem Header="Display" Style="{StaticResource TreeViewItem.AccordionChild}" />
                     <TreeViewItem Header="Language" Style="{StaticResource TreeViewItem.AccordionChild}" />
                 </TreeViewItem>
                 <TreeViewItem Header="Advanced" Style="{StaticResource TreeViewItem.AccordionGroup}">
                     <TreeViewItem Header="Diagnostics" Style="{StaticResource TreeViewItem.AccordionChild}" />
                 </TreeViewItem>
             </TreeViewItem>
         </TreeView>

         Available Styles:
         - TreeView.Standard              : Classic bordered hierarchical tree
         - TreeView.Flush                 : Transparent container (sidebars / panels)
         - TreeViewItem.Standard          : Classic item with expander + indentation
         - TreeViewItem.AccordionParent   : Level 0 – top section header
         - TreeViewItem.AccordionGroup    : Level 1 – intermediate group
         - TreeViewItem.AccordionChild    : Level 2 – final navigable item
         ======================================================================= -->

    <!-- Shared Focus Visual -->
    <Style x:Key="FocusVisual.TreeView" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Vestigium.Brushes.Stroke.Focus}"
                               StrokeThickness="2"
                               StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- 1. TREEVIEW CONTAINERS                     -->
    <!-- ========================================== -->

    <!-- Classic bordered tree -->
    <Style x:Key="TreeView.Standard" TargetType="TreeView">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.TreeView}" />
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent / sidebar container -->
    <Style x:Key="TreeView.Flush" TargetType="TreeView">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.TreeView}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False"
                                      Background="Transparent"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- 2. CLASSIC HIERARCHICAL ITEM               -->
    <!-- ========================================== -->
    <Style x:Key="TreeViewItem.Standard" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Expander -->
                        <ToggleButton x:Name="Expander"
                                      Grid.Column="0"
                                      Grid.Row="0"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Width="16" Height="16">
                                        <Path x:Name="ExpandPath"
                                              Fill="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 0 8 Z"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ExpandPath" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Header -->
                        <Border x:Name="HeaderBorder"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_Header"
                                              ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <!-- Children -->
                        <ItemsPresenter x:Name="ItemsHost"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Grid.Row="1"
                                        Margin="16,0,0,0"
                                        Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                            <Setter TargetName="HeaderBorder" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- 3. ACCORDION LEVEL 0 – PARENT (Section)    -->
    <!-- ========================================== -->
    <Style x:Key="TreeViewItem.AccordionParent" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="4,0,0,0">
                            <Grid Height="38" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="0"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />

                                <Path x:Name="ExpanderArrow"
                                      Grid.Column="1"
                                      Fill="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                                      Width="8" Height="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      RenderTransformOrigin="0.5,0.5"
                                      Visibility="Collapsed">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="ExpanderArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Subtle}" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ExpanderArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ExpanderArrow" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                            <Setter TargetName="ExpanderArrow" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                            <Setter TargetName="HeaderBorder" Property="Background" Value="Transparent" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- 4. ACCORDION LEVEL 1 – GROUP               -->
    <!-- ========================================== -->
    <Style x:Key="TreeViewItem.AccordionGroup" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="4,0,0,0">
                            <Grid Height="34" Margin="28,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="0"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />

                                <Path x:Name="ExpanderArrow"
                                      Grid.Column="1"
                                      Fill="{DynamicResource Vestigium.Brushes.Text.Tertiary}"
                                      Width="7" Height="7"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      RenderTransformOrigin="0.5,0.5"
                                      Visibility="Collapsed">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="ExpanderArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ExpanderArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ExpanderArrow" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                            <Setter TargetName="ExpanderArrow" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                            <Setter TargetName="HeaderBorder" Property="Background" Value="Transparent" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- 5. ACCORDION LEVEL 2 – CHILD (Leaf)        -->
    <!-- ========================================== -->
    <Style x:Key="TreeViewItem.AccordionChild" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="4,0,0,0">
                            <Grid Height="32" Margin="44,0,12,0">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- Still allows deeper nesting if ever needed, but styled as leaf -->
                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                            <Setter TargetName="HeaderBorder" Property="Background" Value="Transparent" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>