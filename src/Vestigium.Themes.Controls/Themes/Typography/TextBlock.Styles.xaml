<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI TEXTBLOCK TYPOGRAPHY STYLES
         =======================================================================
         Usage: 
         <TextBlock Style="{StaticResource TextBlock.Heading}" Text="Section Title" />

         Available Styles:
         - TextBlock.Standard  : Standard 14px body text
         - TextBlock.Heading   : Bold 18px major section header
         - TextBlock.Subheader : SemiBold 16px sub-section header
         - TextBlock.Caption   : Muted 12px secondary / metadata text
         - TextBlock.Error     : Red validation or error text
         ======================================================================= -->

    <!-- Base -->
    <Style x:Key="TextBlock.Base" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Standard body -->
    <Style x:Key="TextBlock.Standard" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}">
        <!-- Inherits base settings -->
    </Style>

    <!-- Heading -->
    <Style x:Key="TextBlock.Heading" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Heading}" />
    </Style>

    <!-- Subheader -->
    <Style x:Key="TextBlock.Subheader" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Heading}" />
    </Style>

    <!-- Caption / helper -->
    <Style x:Key="TextBlock.Caption" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
    </Style>

    <!-- Error / alert -->
    <Style x:Key="TextBlock.Error" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Status.Error}" />
    </Style>

</ResourceDictionary>