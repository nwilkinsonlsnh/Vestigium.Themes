<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI CALENDAR STYLES
         =======================================================================
         Usage: 
         <Calendar Style="{StaticResource Calendar.Standard}" />
         
         Available Styles:
         - Calendar.Standard : Modern full calendar view with rounded selection states.
         - Calendar.Compact  : Minimalist calendar view optimized for dropdown popups.
         ======================================================================= -->

    <!-- ========================================== -->
    <!-- 1. INTERNAL COMPONENT STYLES               -->
    <!-- ========================================== -->

    <!-- Individual Day Button Style -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid x:Name="ButtonGrid" Background="{TemplateBinding Background}">
                        <Border x:Name="SelectionBackground"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Margin="2" />
                        <ContentPresenter x:Name="DayText"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Mouse Over -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>

                        <!-- Selected Date -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter TargetName="SelectionBackground" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Inverse}" />
                        </Trigger>

                        <!-- Today's Date (only when not selected) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsToday" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionBackground" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter TargetName="SelectionBackground" Property="BorderThickness" Value="1" />
                        </MultiTrigger>

                        <!-- Inactive days (other months) -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Inactive}" />
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Stroke.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Month / Year Grid Button Style -->
    <Style TargetType="CalendarButton">
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="ButtonBorder"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            Margin="2">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Inverse}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Pressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Inverse}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Stroke.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================================== -->
    <!-- 2. CALENDAR STYLES                         -->
    <!-- ========================================== -->

    <!-- Base Style -->
    <Style x:Key="Calendar.Base" TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Standard -->
    <Style x:Key="Calendar.Standard" TargetType="Calendar" BasedOn="{StaticResource Calendar.Base}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="8">
                        <StackPanel Name="PART_Root" HorizontalAlignment="Center">
                            <CalendarItem Name="PART_CalendarItem"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Style="{StaticResource {x:Type CalendarItem}}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact (Optimized for DatePicker popups) -->
    <Style x:Key="Calendar.Compact" TargetType="Calendar" BasedOn="{StaticResource Calendar.Base}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                            CornerRadius="6"
                            Padding="6">
                        <Border.Effect>
                            <DropShadowEffect Color="Black"
                                              Opacity="0.15"
                                              BlurRadius="8"
                                              ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel Name="PART_Root" HorizontalAlignment="Center">
                            <CalendarItem Name="PART_CalendarItem"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Style="{StaticResource {x:Type CalendarItem}}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>