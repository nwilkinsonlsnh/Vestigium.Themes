    </Style>

    <!-- ========================================================= -->
    <!-- 5. DANGER                                                 -->
    <!-- ========================================================= -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Status.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Inverse}" />
