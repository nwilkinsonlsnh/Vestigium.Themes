                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Status.WarningHover}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Status.WarningHover}" />
