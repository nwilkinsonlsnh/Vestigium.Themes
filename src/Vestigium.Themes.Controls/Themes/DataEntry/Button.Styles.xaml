<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         BUTTON STYLES
         =======================================================================
         Usage:
         <Button Style="{StaticResource Button.Primary}" Content="Save" />

         Available Styles:
         - Button.Primary   : Main call-to-action (Solid Blue)
         - Button.Secondary : Outline style for secondary / Cancel actions
         - Button.Success   : Resume / Start / Positive actions (Green)
         - Button.Warning   : Pause / Caution actions (Orange)
         - Button.Danger    : Stop / Delete / Destructive actions (Red)
         - Button.Utility   : Ghost button for secondary tools (e.g. Ping)

         Note: Do not apply 'Button.Base' directly. It is for inheritance only.
         ======================================================================= -->

    <!-- Shared Keyboard Focus Visual -->
    <Style x:Key="FocusVisual.Standard" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Vestigium.Brushes.Stroke.Focus}"
                               StrokeThickness="2"
                               StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= -->
    <!-- BASE STYLE                                                -->
    <!-- ========================================================= -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Standard}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ========================================================= -->
    <!-- 1. PRIMARY                                                -->
    <!-- ========================================================= -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Inverse}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Hover}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Pressed}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Control.FillDisabled}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= -->
    <!-- 2. SECONDARY                                              -->
    <!-- ========================================================= -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Default}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= -->
    <!-- 3. SUCCESS                                                -->
    <!-- ========================================================= -->
