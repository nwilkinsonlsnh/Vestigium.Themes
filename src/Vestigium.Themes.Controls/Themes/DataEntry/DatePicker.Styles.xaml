<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI DATEPICKER STYLES
         =======================================================================
         Usage:
         <DatePicker Style="{StaticResource DatePicker.Standard}" />

         Available Styles:
         - DatePicker.Standard   : Standard data entry (highlights to theme blue)
         - DatePicker.Error      : Validation failure state (red border + icon)
         - DatePicker.InlineEdit : Transparent until hovered/focused
         - DatePicker.ReadOnly   : Non-editable display; calendar button hidden
         ======================================================================= -->

    <!-- Shared Focus Visual -->
    <Style x:Key="FocusVisual.DatePicker" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Vestigium.Brushes.Stroke.Focus}"
                               StrokeThickness="2"
                               StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- 1. INTERNAL COMPONENT TEMPLATES            -->
    <!-- ========================================== -->

    <!-- Transparent inner text box so the outer border owns the chrome -->
    <Style x:Key="DatePickerTextBox.Transparent" TargetType="DatePickerTextBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,4,0,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Standard calendar button -->
    <ControlTemplate x:Key="DatePickerButton.Standard" TargetType="Button">
        <Grid Background="Transparent">
            <Border x:Name="ButtonBorder"
                    CornerRadius="0,4,4,0"
                    Background="Transparent"
                    Width="32" />
            <Path x:Name="CalendarIcon"
                  Fill="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M11.5,1.5 H10 V0.5 H9 V1.5 H5 V0.5 H4 V1.5 H2.5 C1.67,1.5 1,2.17 1,3 V12.5 C1,13.33 1.67,14 2.5,14 H11.5 C12.33,14 13,13.33 13,12.5 V3 C13,2.17 12.33,1.5 11.5,1.5 Z M11.5,12.5 H2.5 V5 H11.5 V12.5 Z" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CalendarIcon" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CalendarIcon" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Pressed}" />
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Subtle}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CalendarIcon" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Error calendar button -->
    <ControlTemplate x:Key="DatePickerButton.Error" TargetType="Button">
        <Grid Background="Transparent">
            <Border x:Name="ButtonBorder"
                    CornerRadius="0,4,4,0"
                    Background="Transparent"
                    Width="32" />
            <Path x:Name="CalendarIcon"
                  Fill="{DynamicResource Vestigium.Brushes.Status.Error}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M11.5,1.5 H10 V0.5 H9 V1.5 H5 V0.5 H4 V1.5 H2.5 C1.67,1.5 1,2.17 1,3 V12.5 C1,13.33 1.67,14 2.5,14 H11.5 C12.33,14 13,13.33 13,12.5 V3 C13,2.17 12.33,1.5 11.5,1.5 Z M11.5,12.5 H2.5 V5 H11.5 V12.5 Z" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Status.ErrorFill}" />
                <Setter TargetName="CalendarIcon" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Status.ErrorHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CalendarIcon" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ========================================== -->
    <!-- 2. DATEPICKER STYLES                       -->
    <!-- ========================================== -->

    <!-- Base -->
    <Style x:Key="DatePicker.Base" TargetType="DatePicker">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.DatePicker}" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <!-- Standard -->
    <Style x:Key="DatePicker.Standard" TargetType="DatePicker" BasedOn="{StaticResource DatePicker.Base}">
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Style="{StaticResource DatePickerTextBox.Transparent}"
                                               Focusable="{TemplateBinding Focusable}"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Center" />

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Template="{StaticResource DatePickerButton.Standard}"
                                    Focusable="False" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Root}"
                                   StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Control.FillDisabled}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Strong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Error -->
    <Style x:Key="DatePicker.Error" TargetType="DatePicker" BasedOn="{StaticResource DatePicker.Base}">
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Status.Error}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Status.ErrorFill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Style="{StaticResource DatePickerTextBox.Transparent}"
                                               Focusable="{TemplateBinding Focusable}"
                                               Foreground="{DynamicResource Vestigium.Brushes.Status.Error}"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Center" />

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Template="{StaticResource DatePickerButton.Error}"
                                    Focusable="False" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Root}"
                                   StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Status.ErrorHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Control.FillDisabled}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Strong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inline Edit -->
    <Style x:Key="DatePicker.InlineEdit" TargetType="DatePicker" BasedOn="{StaticResource DatePicker.Base}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Style="{StaticResource DatePickerTextBox.Transparent}"
                                               Focusable="{TemplateBinding Focusable}"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Center" />

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Template="{StaticResource DatePickerButton.Standard}"
                                    Focusable="False"
                                    Opacity="0" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Root}"
                                   StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
                            <Setter TargetName="PART_Button" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
                            <Setter TargetName="PART_Button" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                            <Setter TargetName="PART_Button" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-Only -->
    <Style x:Key="DatePicker.ReadOnly" TargetType="DatePicker" BasedOn="{StaticResource DatePicker.Base}">
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <!-- No button or popup – pure display -->
                        <DatePickerTextBox x:Name="PART_TextBox"
                                           Style="{StaticResource DatePickerTextBox.Transparent}"
                                           IsReadOnly="True"
                                           Focusable="True"
                                           HorizontalContentAlignment="Stretch"
                                           VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>