<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI DOCKPANEL STYLES
         =======================================================================
         Note:
         Application chrome region styles (AppHeader, AppSidebar, StatusBar)
         have been moved to Border.Styles.xaml for better organization.

         Use those Border styles as region wrappers inside a DockPanel:

         <DockPanel>
             <Border Style="{StaticResource Border.AppHeader}" DockPanel.Dock="Top">
                 ...
             </Border>
             <Border Style="{StaticResource Border.AppSidebar}" DockPanel.Dock="Left" Width="240">
                 ...
             </Border>
             <Border Style="{StaticResource Border.StatusBar}" DockPanel.Dock="Bottom">
                 ...
             </Border>
             (Main content fills remaining space)
         </DockPanel>

         Available Styles in this file:
         - DockPanel.Standard : Transparent baseline DockPanel
         ======================================================================= -->

    <!-- Baseline DockPanel (rarely needs more than this) -->
    <Style x:Key="DockPanel.Standard" TargetType="DockPanel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="LastChildFill" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>