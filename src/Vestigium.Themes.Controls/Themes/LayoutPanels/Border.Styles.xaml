<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI BORDER STYLES
         =======================================================================
         Usage: 
         <Border Style="{StaticResource Border.Card}">
             <TextBlock Text="Card Content" />
         </Border>

         Available Styles:
         General containers
         - Border.Standard   : Simple rounded container
         - Border.Card       : Dashboard card (6px radius)
         - Border.CardShadow : Card with subtle drop shadow
         - Border.Panel      : Light gray section background
         - Border.Accent     : Theme blue left accent bar
         - Border.Error      : Validation / alert border

         Application chrome regions (for use inside DockPanel)
         - Border.AppHeader  : Top region with bottom divider
         - Border.AppSidebar : Left/Right region with side divider
         - Border.StatusBar  : Bottom region with top divider
         ======================================================================= -->

    <!-- ========================================== -->
    <!-- 1. GENERAL CONTAINERS                      -->
    <!-- ========================================== -->

    <!-- Standard -->
    <Style x:Key="Border.Standard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Card -->
    <Style x:Key="Border.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Card + shadow -->
    <Style x:Key="Border.CardShadow" TargetType="Border" BasedOn="{StaticResource Border.Card}">
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Disabled}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel -->
    <Style x:Key="Border.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Accent (left highlight bar) -->
    <Style x:Key="Border.Accent" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Error -->
    <Style x:Key="Border.Error" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Status.ErrorFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Status.Error}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ========================================== -->
    <!-- 2. APPLICATION CHROME REGIONS              -->
    <!--    (Intended for DockPanel layouts)        -->
    <!-- ========================================== -->

    <!-- Top application header -->
    <Style x:Key="Border.AppHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Side navigation panel -->
    <Style x:Key="Border.AppSidebar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Bottom status bar -->
    <Style x:Key="Border.StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>