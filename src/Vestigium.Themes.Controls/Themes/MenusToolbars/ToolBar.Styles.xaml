<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
     COMMON UI TOOLBAR STYLES
     =======================================================================
     Usage:
     <ToolBarTray Style="{StaticResource ToolBarTray.Standard}">
         <ToolBar Style="{StaticResource ToolBar.Standard}">
             <Button Content="New" />
             <Button Content="Save" />
             <Separator />
             <Button Content="Settings" />
         </ToolBar>
     </ToolBarTray>

     Available Styles (defined in this file):
     - ToolBar.Standard : Modern flat horizontal toolbar
     - ToolBar.Card     : Rounded inset / floating toolbar

     Related styles (defined elsewhere):
     - ToolBarTray.Standard / Vertical / Locked  → ToolBarTray.Styles.xaml
     - ToolBarPanel.Standard                     → ToolBarPanel.Styles.xaml
     ======================================================================= -->

    <!-- ========================================== -->
    <!-- 1. OVERFLOW BUTTON                         -->
    <!-- ========================================== -->
    <Style x:Key="ToolBar.OverflowButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="OverflowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <Path x:Name="OverflowGlyph"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Width="8"
                              Height="5"
                              Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OverflowBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
                            <Setter TargetName="OverflowGlyph" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OverflowBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Subtle}" />
                            <Setter TargetName="OverflowGlyph" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OverflowGlyph" Property="Fill" Value="{DynamicResource Vestigium.Brushes.Stroke.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- 3. BASE TOOLBAR                            -->
    <!-- ========================================== -->
    <Style x:Key="ToolBar.Base" TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Border x:Name="ToolBarBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <ToggleButton x:Name="OverflowButton"
                                          DockPanel.Dock="Right"
                                          Style="{StaticResource ToolBar.OverflowButton}"
                                          Visibility="{TemplateBinding HasOverflowItems}"
                                          IsChecked="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ToolBarPanel x:Name="PART_ToolBarPanel"
                                          IsItemsHost="True"
                                          Margin="0,1" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ToolBarBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Disabled}" />
                            <Setter TargetName="ToolBarBorder" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- 4. STANDARD TOOLBAR                        -->
    <!-- ========================================== -->
    <Style x:Key="ToolBar.Standard" TargetType="ToolBar" BasedOn="{StaticResource ToolBar.Base}">
        <!-- Inherits flat horizontal layout -->
    </Style>

    <!-- ========================================== -->
    <!-- 5. CARD / FLOATING TOOLBAR                 -->
    <!-- ========================================== -->
    <Style x:Key="ToolBar.Card" TargetType="ToolBar" BasedOn="{StaticResource ToolBar.Base}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Border x:Name="ToolBarBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <ToggleButton x:Name="OverflowButton"
                                          DockPanel.Dock="Right"
                                          Style="{StaticResource ToolBar.OverflowButton}"
                                          Visibility="{TemplateBinding HasOverflowItems}"
                                          IsChecked="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ToolBarPanel x:Name="PART_ToolBarPanel"
                                          IsItemsHost="True"
                                          Margin="0,1" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ToolBarBorder" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Disabled}" />
                            <Setter TargetName="ToolBarBorder" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>