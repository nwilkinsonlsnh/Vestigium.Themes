<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         COMMON UI STATUSBAR STYLES
         =======================================================================
         Usage: 
         <StatusBar Style="{StaticResource StatusBar.Standard}">
             <StatusBarItem Style="{StaticResource StatusBarItem.Standard}">
                 <TextBlock Text="Ready" />
             </StatusBarItem>
             <Separator Style="{StaticResource Separator.StatusBar}" />
             <StatusBarItem Style="{StaticResource StatusBarItem.Standard}">
                 <TextBlock Text="UTF-8" />
             </StatusBarItem>
         </StatusBar>

         Available Styles:
         - StatusBar.Standard      : Modern flat bottom status bar
         - StatusBarItem.Standard  : Consistent inner padding for status elements
         - Separator.StatusBar     : Vertical divider between status items
         ======================================================================= -->

    <!-- ========================================== -->
    <!-- 1. STATUSBAR                               -->
    <!-- ========================================== -->
    <Style x:Key="StatusBar.Base" TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Header}" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StatusBar.Standard" TargetType="StatusBar" BasedOn="{StaticResource StatusBar.Base}">
        <!-- Inherits base settings -->
    </Style>

    <!-- ========================================== -->
    <!-- 2. STATUSBAR ITEM                          -->
    <!-- ========================================== -->
    <Style x:Key="StatusBarItem.Standard" TargetType="StatusBarItem">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========================================== -->
    <!-- 3. STATUSBAR SEPARATOR                     -->
    <!-- ========================================== -->
    <Style x:Key="Separator.StatusBar" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Stroke.Strong}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Margin="{TemplateBinding Margin}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>